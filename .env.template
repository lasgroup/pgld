# PGLD Environment Configuration Template
# Copy this file to .env.local and customize if needed
# The .env.local file is git-ignored and won't be committed

# User-specific paths (update PGLD_PROJECT_ROOT if you renamed the folder)
export PGLD_USER=${USER}
export PGLD_HOME=/cluster/home/${USER}
export PGLD_SCRATCH=/cluster/scratch/${USER}
export PGLD_PROJECT_ROOT=/cluster/home/${USER}/pgld

# Conda configuration (customize path to your conda installation)
export PGLD_CONDA_BASE=${PGLD_HOME}/miniconda3
export PGLD_CONDA_ENV=pgld_basic      # base env: all non-PLM experiments (optimizer, BO, MHC)
export PGLD_PLM_CONDA_ENV=pgld_plm    # PLM experiments only (ESM2, IgLM); python 3.10 + flash-attn
export PGLD_MHC_CONDA_ENV=pgld_basic  # MHC runs in the base env; separated only for extra TF/XLA flags

# Project paths
export PGLD_PKG_ROOT=${PGLD_PROJECT_ROOT}/pgld

# Output directories
export PGLD_OUTPUT_DIR=${PGLD_SCRATCH}/outputs

# Model assets directory (oracle checkpoints, ESM2 weights, datasets, etc.)
export PGLD_ASSETS_DIR=${PGLD_PROJECT_ROOT}/assets

# Landscape datasets
export PGLD_DATASETS_DIR=${PGLD_ASSETS_DIR}/datasets/

# ESM2 checkpoints
export PGLD_ESM2_CKPT_DIR=${PGLD_ASSETS_DIR}/esm2/

# Riboswitch oracles
export PGLD_RIBOSWITCH_ORACLE_DIR=${PGLD_ASSETS_DIR}/riboswitch/
export PGLD_RIBOSWITCH_DATA=${PGLD_ASSETS_DIR}/riboswitch/data/

# Cluster modules (required for flash-attn compilation)
# Run 'module avail' to see what's available on your cluster, then update these.
# Delete any line that doesn't apply to your cluster.
export PGLD_PYTHON_MODULE=python/3.11.6       # or delete if conda handles python
export PGLD_STACK_MODULE=stack/2024-06        # cluster-specific, delete if not needed
export PGLD_GCC_MODULE=gcc/12.2.0
export PGLD_CUDA_MODULE=cuda/13.0.2
